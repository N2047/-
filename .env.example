# ====================================================================
# Disability Information Center (DIC) - Environment Configuration
# ====================================================================

# 1. N8N Webhook URL for AI Chatbot (Linked with OpenAI via n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/dic-chat

# 2. Direct OpenAI API Key (Optional fallback if n8n is not used)
OPENAI_API_KEY=

# 3. Supabase Configuration (Optional for Cloud Database sync)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# ====================================================================
# 4. Email Dispatch Configuration (Nodemailer / Gmail SMTP / Custom SMTP)
# ====================================================================
# Option A: Gmail SMTP (Recommended for quick setup)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=info.dic.koshi@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option B: Generic / Enterprise SMTP (Brevo, SendGrid, Amazon SES, or Gov Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info.dic.koshi@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# ====================================================================
# 5. Grievance Mandatory Dual CC Emails (Ministry & Federation)
# ====================================================================
GRIEVANCE_MINISTRY_CC_EMAIL=info.dic@koshi.gov.np
GRIEVANCE_NFDN_CC_EMAIL=koshi@nfdn.org.np

