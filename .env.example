# ====================================================================
# Disability Information Center (DIC) - Environment Configuration
# ====================================================================

# 1. N8N Webhook URL for AI Chatbot (Linked with OpenAI via n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/dic-chat

# 2. Direct OpenAI API Key (Optional fallback if n8n is not used)
OPENAI_API_KEY=

# 3. Supabase Configuration (Optional for Cloud Database sync)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
