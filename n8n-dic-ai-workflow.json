{
  "name": "DIC Disability Information Center AI Agent Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dic-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "webhook-trigger-node",
      "name": "DIC Chat Webhook"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=तपाईं नेपालको 'अपाङ्गता सूचना केन्द्र' (Disability Information Center - DIC) को आधिकारिक AI सहायक हुनुहुन्छ।\n\nकोशी प्रदेशका १४ जिल्ला, १३७ स्थानीय तह, अपाङ्गता भएका व्यक्तिको अधिकार सम्बन्धी ऐन २०७४, नियमावली २०७७, १० प्रकारका अपाङ्गता, चार प्रकारका परिचयपत्र (रातो, निलो, पहेँलो, सेतो), वार्षिक प्रतिवेदन (४४ प्रश्न तथा अनुसूची १.१ र १.२) का आधारमा आधिकारिक तथा तथ्यपरक जवाफ नेपाली भाषामा दिनुहोस्।\n\nसान्दर्भिक वेब एप सन्दर्भ (Retrieved Knowledge):\n{{ JSON.stringify($json.body.context?.retrievedSnippets || []) }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        300,
        0
      ],
      "id": "ai-agent-node",
      "name": "DIC AI Agent"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.3,
          "maxTokens": 1000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        260,
        220
      ],
      "id": "openai-model-node",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $('DIC Chat Webhook').item.json.body.sessionId || 'default-dic-session' }}",
        "contextWindowLength": 5
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        400,
        220
      ],
      "id": "memory-node",
      "name": "Window Buffer Memory"
    },
    {
      "parameters": {
        "name": "query_dic_knowledge_base",
        "description": "Call this tool to search live laws, news, statistics, and 137 local government reports from the Disability Information Center web app.",
        "method": "GET",
        "url": "=http://localhost:3001/api/ai-knowledge?q={{ encodeURIComponent($fromAI('query', 'search query in Nepali or English')) }}",
        "responseFormat": "json"
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        540,
        220
      ],
      "id": "knowledge-tool-node",
      "name": "DIC Knowledge API Tool"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"output\": {{ JSON.stringify($json.output || $json.text || \"\") }},\n  \"status\": \"success\",\n  \"provider\": \"n8n-openai\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        0
      ],
      "id": "respond-webhook-node",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "DIC Chat Webhook": {
      "main": [
        [
          {
            "node": "DIC AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "DIC AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "DIC AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "DIC Knowledge API Tool": {
      "ai_tool": [
        [
          {
            "node": "DIC AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "DIC AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
